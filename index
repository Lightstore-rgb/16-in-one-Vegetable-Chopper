            <button class="thumb" type="button" data-image="https://m.media-amazon.com/images/I/71HlTa9aXsL._AC_SL1500_.jpg" aria-label="Product image 2"><img src="https://m.media-amazon.com/images/I/71HlTa9aXsL._AC_SL1500_.jpg" alt=""></button>
            <button class="thumb" type="button" data-image="https://m.media-amazon.com/images/I/71hRPTwTljL._AC_SL1500_.jpg" aria-label="Product image 3"><img src="https://m.media-amazon.com/images/I/71hRPTwTljL._AC_SL1500_.jpg" alt=""></button>
            <button class="thumb" type="button" data-image="https://m.media-amazon.com/images/I/71OA2QAJUkL._AC_SL1500_.jpg" aria-label="Product image 4"><img src="https://m.media-amazon.com/images/I/71OA2QAJUkL._AC_SL1500_.jpg" alt=""></button>
