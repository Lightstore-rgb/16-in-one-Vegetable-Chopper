      <p class="video-caption">Watch the product demonstration on this page.</p>
    </section>

    <section class="section" id="reviews">
      <h2>Customer Reviews</h2>
      <div class="reviews-note"><strong>Reviews will appear here.</strong> Customer feedback should be added after genuine orders and verified customer experiences. No sample or invented reviews are displayed.</div>
    </section>
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <div>
        <div class="footer-brand">Kitchen Art</div>
        <p>Kitchen essentials for everyday use.</p>
      </div>
      <nav class="footer-legal" aria-label="Legal information">
        <a href="#terms-of-use">Conditions of Use</a>
        <a href="#privacy-notice">Privacy Notice</a>
        <a href="#privacy-disclosure">Privacy Disclosure</a>
        <a href="#privacy-choices">Your Privacy Choices</a>
      </nav>
    </div>
    <div class="copyright">© <span id="year"></span> Kitchen Art. All rights reserved.</div>
  </footer>

  <!-- Order form stays hidden until Buy Now is selected. -->
  <div class="modal" id="orderModal" role="dialog" aria-modal="true" aria-labelledby="orderTitle">
    <div class="modal-card">
      <button class="modal-close" type="button" id="closeOrder" aria-label="Close order form">×</button>
      <h2 id="orderTitle">Cash on Delivery Order</h2>
      <p class="modal-intro">Enter your delivery details. Free delivery in 3–5 days. Pay by Cash on Delivery.</p>
      <div id="checkoutFormView">
      <form id="orderForm" action="https://formspree.io/f/mdegnlob" method="POST">
        <div class="form-row">
          <label for="name">Full name</label>
          <input id="name" name="name" autocomplete="name" required>
        </div>
        <div class="form-row">
          <label for="phone">Mobile number</label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="03XX XXXXXXX" required>
        </div>
        <div class="form-row">
          <label for="city">City</label>
          <input id="city" name="city" autocomplete="address-level2" required>
        </div>
        <div class="form-row">
          <label for="address">Complete delivery address</label>
          <textarea id="address" name="address" autocomplete="street-address" placeholder="House, street, area and nearby landmark" required></textarea>
        </div>
        <input type="hidden" name="Product" value="16-in-1 Vegetable Cutter & Food Chopper">
        <input type="hidden" name="Order total" value="Rs. 2,799">
        <input type="hidden" name="Delivery" value="Free delivery; estimated 3–5 days">
        <input type="hidden" name="Payment method" value="Cash on Delivery">
        <input type="hidden" name="_subject" value="New Kitchen Art website order">
        <div class="form-total"><span>Total payable</span><span>Rs. 2,799</span></div>
        <button class="buy-button" id="submitOrder" type="submit">Place Order</button>
        <div class="success-message" id="orderResult" role="status" aria-live="polite"></div>
      </form>
      </div>
      <section id="thankYouView" class="thank-you" hidden aria-live="polite">
        <h2>Thank you for your order.</h2>
        <p>Your order request has been submitted successfully to Kitchen Art.</p>
        <p>We will contact you to confirm your order. Your parcel is expected to arrive within <strong>3–5 days</strong> at the delivery address you provided.</p>
        <p>Payment is due in cash when your order is delivered.</p>
        <button class="buy-button" type="button" id="finishOrder">Continue shopping</button>
      </section>
    </div>
  </div>

  <script>
    // Product image selector
    const mainImage = document.getElementById('mainImage');
    document.querySelectorAll('.thumb').forEach((button) => {
      button.addEventListener('click', () => {
        mainImage.src = button.dataset.image;
        document.querySelectorAll('.thumb').forEach((thumb) => thumb.classList.remove('active'));
        button.classList.add('active');
      });
    });

    // Reveal the order form only after Buy Now is clicked.
    const modal = document.getElementById('orderModal');
    const openOrder = () => {
      modal.classList.add('open');
      document.getElementById('name').focus();
      document.body.style.overflow = 'hidden';
    };
    const closeOrder = () => {
      modal.classList.remove('open');
      document.body.style.overflow = '';
    };
    document.getElementById('openOrder').addEventListener('click', openOrder);
    document.getElementById('closeOrder').addEventListener('click', closeOrder);
    modal.addEventListener('click', (event) => {
      if (event.target === modal) closeOrder();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeOrder();
    });

    // Submit the order directly to Formspree and show the confirmation only on success.
    const orderForm = document.getElementById('orderForm');
    const submitOrder = document.getElementById('submitOrder');
    const checkoutFormView = document.getElementById('checkoutFormView');
    const thankYouView = document.getElementById('thankYouView');

    orderForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const result = document.getElementById('orderResult');
      if (!orderForm.reportValidity()) return;

      submitOrder.disabled = true;
      submitOrder.textContent = 'Submitting…';
      result.style.display = 'block';
      result.textContent = 'Sending your order securely. Please wait.';

      try {
        const response = await fetch(orderForm.action, {
          method: 'POST',
          body: new FormData(orderForm),
          headers: { 'Accept': 'application/json' }
        });

        if (!response.ok) {
          let message = 'We could not submit your order. Please try again.';
          try {
            const payload = await response.json();
            if (payload.errors) message = payload.errors.map(error => error.message).join(' ');
          } catch (_) {}
          throw new Error(message);
        }

        checkoutFormView.hidden = true;
        thankYouView.hidden = false;
        document.getElementById('orderTitle').textContent = 'Order request received';
      } catch (error) {
        result.textContent = error.message || 'Network error. Please check your connection and try again.';
        submitOrder.disabled = false;
        submitOrder.textContent = 'Place Order';
      }
    });

    document.getElementById('finishOrder').addEventListener('click', () => {
      closeOrder();
      orderForm.reset();
      checkoutFormView.hidden = false;
      thankYouView.hidden = true;
      document.getElementById('orderTitle').textContent = 'Cash on Delivery Order';
      const result = document.getElementById('orderResult');
      result.style.display = 'none';
      result.textContent = '';
      submitOrder.disabled = false;
      submitOrder.textContent = 'Place Order';
    });

    document.getElementById('year').textContent = new Date().getFullYear();
  </script>
</body>
</html>
