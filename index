      </div>
    </section>

    <section class="section" id="specifications">
      <h2>Product Specifications</h2>
      <table class="spec-table">
        <tbody>
          <tr><th>Brand</th><td>QDGMXIV</td></tr>
          <tr><th>Product</th><td>16-in-1 Vegetable Cutter</td></tr>
          <tr><th>Dimensions</th><td>13 × 4.5 × 4.7 inches</td></tr>
